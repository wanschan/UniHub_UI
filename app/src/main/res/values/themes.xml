<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.CampusLink" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorPrimaryVariant">@color/ink</item>
        <item name="colorOnPrimary">@color/on_ink</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.CampusLink.Dialog</item>
    </style>

    <style name="Theme.CampusLink.Splash">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="ThemeOverlay.CampusLink.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.CampusLink.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.CampusLink.DialogButton</item>
    </style>

    <style name="Widget.CampusLink.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/ink</item>
    </style>

</resources>
